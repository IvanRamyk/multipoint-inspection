/else
/venv
/logs
/results

# The autonomous-experiment workflow lives in .claude/ and IS version-controlled:
# agent definitions, the loop command, and project settings. Everything else
# under .claude/ is local session state.
/.claude/*
!/.claude/agents/
!/.claude/commands/
!/.claude/hooks/
!/.claude/settings.json

# Volatile orchestrator state. The campaign artifacts under experiments/campaigns/
# are tracked; the live state files are not.
/experiments/state/*
!/experiments/state/.gitkeep

# The checksum manifest is generated by tools/setup_guard.sh at guard start over
# the current tree, so it is environment state, not source. Tracking it would show
# as an untracked file in the reviewer's `git status --porcelain tools/` scan.
/tools/checksums.sha256

/drone_inspection_dreamer.egg-info
/.idea
CLAUDE.md
.env
__pycache__/
*.pyc
*.egg-info/
.DS_Store

# Accidental literal "~" directory from an unquoted shell expansion.
/~/
.claude/settings.local.json
